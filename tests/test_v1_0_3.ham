# test_v1_0_3.ham
# Exercises the two v1.0.3 follow-up fixes:
#   1. jaza - should pop up a dialog box when run through Notepad.py,
#      instead of silently blocking on the terminal.
#   2. Syntax highlighting - paste/open this file in Notepad.py and
#      confirm keywords, strings, operators, and numbers are colored
#      correctly, right up to (and including) the closing quote of
#      every string.

kwanza
    # --- jaza: type a name, then a whole number age ---
    jaza "Enter your name: ", jina
    jaza "Enter your age: ", umri

    chapa "Habari, " + jina + "!"
    chapa "You said your age is: " + umri
    aina umri

    kama umri inazidi 17
        chapa "Wewe ni mtu mzima (you are an adult)"
    sivyo
        chapa "Wewe ni kijana (you are a minor)"
    kwisha

    # --- a spread of token types, to eyeball highlighting on ---
    hesabu = 0
    wakati hesabu haizidi 3
        chapa "wakati: " + hesabu
        hesabu = hesabu ongeza 1
    kwisha

    huku i kutoka 0 hadi 3
        chapa "huku: " + i
    kwisha

    orodha = ["chai", "kahawa", "maji"]
    weka "soda" kwenye orodha
    chapa "orodha ina vitu " + idadi orodha
    huku kinywaji kwenye orodha
        chapa kinywaji
    kwisha

    darasa Mnyama
        eleza jenga(jina, sauti)
            nafsi.jina = jina
            nafsi.sauti = sauti
        kwisha

        eleza tangaza()
            rudisha nafsi.jina + " anasema " + nafsi.sauti
        kwisha
    kwisha

    simba = Mnyama("Simba", "Ngurumo")
    chapa simba.tangaza()
    aina simba

    chapa 1 kabisa true
    chapa 1 sawa na true
kwisha
