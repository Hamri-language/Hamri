darasa Mtu
    eleza jenga(jina)
        nafsi.jina = jina
    kwisha
    eleza salamu()
        rudisha "Habari, mimi ni " + nafsi.jina
    kwisha
    eleza boomProperty()
        chapa nafsi.haijulikani
    kwisha
kwisha

eleza boomFunction()
    chapa haijulikani_kazi
kwisha

kwanza
    chapa "checkpoint A"
    chapa haijulikani_juu

    kama kweli sivyo
        chapa "unreachable"
    kwisha

    wakati haijulikani_wakati haizidi 5
        chapa "unreachable loop"
    kwisha

    huku i kutoka 0 hadi 3
        chapa haijulikani_huku
    kwisha

    boomFunction()

    mtu1 = Mtu("Amara")
    mtu1.boomProperty()

    orodha = [1, 2, 3]
    chapa orodha[10]

    ondoa 99 kutoka orodha

    haijulikani_kazi_pia()
kwisha
